# CC91 论坛系统 - Docker 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== 必填 =====

# MySQL
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT（至少 32 字符，建议用 openssl rand -base64 48 生成）
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# 微服务间内部通信令牌
INTERNAL_TOKEN=your_internal_token

# ===== 可选 =====

# 邮件功能（不配置则邮件功能不可用）
MAIL_USERNAME=
MAIL_PASSWORD=
